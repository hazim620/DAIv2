# Preprod environment - copy to .env when migrating/testing preprod locally
# cp .env.preprod.example .env
# Ensure SSH tunnel to preprod RDS is running (e.g. port 5433)

# Preprod DB (via tunnel: localhost or tunnel host)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dai_preprod
DB_USER=<PREPROD_DB_USER>
DB_PASSWORD=<PREPROD_DB_PASSWORD>
DB_SSL=true

# JWT (preprod - different from prod)
JWT_SECRET=<PREPROD_JWT_SECRET_MIN_32_CHARS>

# AWS (server-side)
APP_AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
APP_AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
APP_AWS_REGION=me-south-1
APP_S3_BUCKET=dai-platform-media-preprod
APP_CLOUDFRONT_DOMAIN=d2pqexip67u30k.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=EF7TG1IDOIW22

# Presign Service (Legacy) - optional
APP_PRESIGN_SERVICE_URL=
APP_PRESIGN_SERVICE_TOKEN=

# Direct browser -> S3
NEXT_PUBLIC_APP_AWS_REGION=me-south-1
NEXT_PUBLIC_APP_S3_BUCKET=dai-platform-media-preprod
NEXT_PUBLIC_APP_CLOUDFRONT_DOMAIN=d2pqexip67u30k.cloudfront.net
NEXT_PUBLIC_APP_COGNITO_IDENTITY_POOL_ID=<SAME_OR_PREPROD_IDENTITY_POOL_ID>
