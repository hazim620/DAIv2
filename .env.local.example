# Local dev environment - copy to .env when running locally
# cp .env.local.example .env
# docker compose up -d  then  npm run migrate:dev  then  npm run dev

# Local Docker DB (config/database.dev.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dai_dev
DB_USER=dai_dev_user
DB_PASSWORD=dai_dev_password
DB_SSL=false

# JWT (dev only - keep short for local)
JWT_SECRET=dev-jwt-secret-min-32-characters-long

# AWS (server-side) - same IAM or dev IAM
APP_AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
APP_AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
APP_AWS_REGION=me-south-1
APP_S3_BUCKET=dai-platform-media-dev
APP_CLOUDFRONT_DOMAIN=<YOUR_DEV_CLOUDFRONT_DOMAIN>.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=<YOUR_DEV_DISTRIBUTION_ID>

# Presign Service (Legacy) - optional for local
APP_PRESIGN_SERVICE_URL=
APP_PRESIGN_SERVICE_TOKEN=

# Direct browser -> S3 (NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_AWS_REGION=me-south-1
NEXT_PUBLIC_APP_S3_BUCKET=dai-platform-media-dev
NEXT_PUBLIC_APP_CLOUDFRONT_DOMAIN=<YOUR_DEV_CLOUDFRONT_DOMAIN>.cloudfront.net
NEXT_PUBLIC_APP_COGNITO_IDENTITY_POOL_ID=<SAME_OR_DEV_IDENTITY_POOL_ID>
