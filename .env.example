# Database Configuration
DB_HOST=dai-platform.cnkksc4kgd5b.me-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=true

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# S3 + CloudFront (for browser uploads via presigned PUT)
# IMPORTANT: do NOT commit real keys. Set these in Amplify environment variables.
APP_AWS_REGION=me-south-1
APP_S3_BUCKET=dai-platform-media-prod
APP_CLOUDFRONT_DOMAIN=dph2pdp0ht6hr.cloudfront.net
APP_AWS_ACCESS_KEY_ID=REPLACE_ME
APP_AWS_SECRET_ACCESS_KEY=REPLACE_ME

# If Amplify runtime can't access AWS credentials, use external signer Lambda:
APP_PRESIGN_SERVICE_URL=REPLACE_ME
APP_PRESIGN_SERVICE_TOKEN=REPLACE_ME
