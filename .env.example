# Database Configuration
DB_HOST=your-database-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_SSL=true

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# AWS Configuration (Server-side)
APP_AWS_ACCESS_KEY_ID=your-aws-access-key-id
APP_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
APP_AWS_REGION=me-south-1
APP_S3_BUCKET=your-s3-bucket-name
APP_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# Presign Service (Legacy - may be removed after migration)
APP_PRESIGN_SERVICE_URL=https://your-lambda-url.lambda-url.me-south-1.on.aws/
APP_PRESIGN_SERVICE_TOKEN=your-presign-service-token

# Direct browser -> S3 uploads
# These must be NEXT_PUBLIC_* because uploads happen in the browser.
NEXT_PUBLIC_APP_AWS_REGION=me-south-1
NEXT_PUBLIC_APP_S3_BUCKET=dai-platform-media-prod
NEXT_PUBLIC_APP_CLOUDFRONT_DOMAIN=dph2pdp0ht6hr.cloudfront.net

# Cognito Identity Pool (for temporary AWS credentials in the browser)
NEXT_PUBLIC_APP_COGNITO_IDENTITY_POOL_ID=me-south-1:2a00695f-009a-4b97-be8c-5d0d1ac15dd2
