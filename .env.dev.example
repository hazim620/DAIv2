# Copy to .env when running locally against docker dev DB
# docker compose up -d   then copy this file to .env

# Dev DB (matches config/database.dev.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dai_dev
DB_USER=dai_dev_user
DB_PASSWORD=dai_dev_password
DB_SSL=false

# JWT (dev only)
JWT_SECRET=dev-jwt-secret-min-32-characters-long

# Add other vars from .env.example as needed (AWS, etc.)
