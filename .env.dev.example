# Copy to .env when running locally against docker dev DB
# docker compose up -d   then copy this file to .env

# Dev DB (matches config/database.dev.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dai_dev
DB_USER=dai_dev_user
DB_PASSWORD=dai_dev_password
DB_SSL=false

# JWT (dev only)
JWT_SECRET=dev-jwt-secret-min-32-characters-long

# AWS / CloudFront (dev bucket)
APP_AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
APP_AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
APP_AWS_REGION=me-south-1
APP_S3_BUCKET=<YOUR_DEV_S3_BUCKET>
APP_CLOUDFRONT_DOMAIN=drf3m9s2aw24c.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=E2GT92XJ9KT7M7
NEXT_PUBLIC_APP_AWS_REGION=me-south-1
NEXT_PUBLIC_APP_S3_BUCKET=<YOUR_DEV_S3_BUCKET>
NEXT_PUBLIC_APP_CLOUDFRONT_DOMAIN=drf3m9s2aw24c.cloudfront.net
NEXT_PUBLIC_APP_COGNITO_IDENTITY_POOL_ID=<YOUR_DEV_IDENTITY_POOL_ID>
