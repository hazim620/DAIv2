# Production environment - copy to .env when migrating prod locally
# cp .env.prod.example .env
# Ensure SSH tunnel to prod RDS is running (e.g. port 5434)

# Prod DB (via tunnel or direct RDS endpoint)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=<PROD_DB_NAME>
DB_USER=<PROD_DB_USER>
DB_PASSWORD=<PROD_DB_PASSWORD>
DB_SSL=true

# JWT (prod - MUST be strong and unique)
JWT_SECRET=<PROD_JWT_SECRET_MIN_32_CHARS>

# AWS (server-side)
APP_AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
APP_AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
APP_AWS_REGION=me-south-1
APP_S3_BUCKET=dai-platform-media-prod
APP_CLOUDFRONT_DOMAIN=dph2pdp0ht6hr.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=<YOUR_PROD_DISTRIBUTION_ID>

# Presign Service (Legacy) - optional
APP_PRESIGN_SERVICE_URL=
APP_PRESIGN_SERVICE_TOKEN=

# Direct browser -> S3
NEXT_PUBLIC_APP_AWS_REGION=me-south-1
NEXT_PUBLIC_APP_S3_BUCKET=dai-platform-media-prod
NEXT_PUBLIC_APP_CLOUDFRONT_DOMAIN=dph2pdp0ht6hr.cloudfront.net
NEXT_PUBLIC_APP_COGNITO_IDENTITY_POOL_ID=<YOUR_IDENTITY_POOL_ID>
